{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "types": ["vite/client"],
    "allowArbitraryExtensions": true,
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* 路径别名：与 vite.config.ts 的 resolve.alias 保持一致。
       不设 baseUrl——TypeScript 6 已废弃它，paths 直接相对本文件解析。 */
    "paths": {
      "@/*": ["./src/*"]
    },

    /* 严格性：ADR-0006 要求 strict。
       noUncheckedIndexedAccess 额外拦截「数组越界取值」，对表格与分页场景价值高。 */
    "strict": true,
    "noUncheckedIndexedAccess": true,

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"]
}
