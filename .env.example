# ============================================================
# 环境变量模板
# ------------------------------------------------------------
# 用法：
#   1. cp .env.example .env
#   2. 在 .env 中填入真实值
#   3. .env 已被 .gitignore 忽略，严禁提交
#
# 规则：
#   - 本文件只放「占位值」，绝不放真实密钥
#   - 新增变量必须在此登记，并注明用途与是否必填
# ============================================================

# ------------------------------------------------------------
# 运行环境
# ------------------------------------------------------------
# 可选值: development | test | staging | production
APP_ENV=development

# 调试开关，生产环境必须为 false（开启后会输出完整 SQL）
APP_DEBUG=true

# 服务监听地址与端口
APP_HOST=0.0.0.0
APP_PORT=8080

# 服务基础地址（用于拼接回调、生成链接）
APP_BASE_URL=http://localhost:8080

# 日志级别: debug | info | warn | error
LOG_LEVEL=debug


# ------------------------------------------------------------
# 数据库
# ------------------------------------------------------------
# 驱动类型：postgres 或 sqlite
DB_DRIVER=sqlite

# --- SQLite 专用（DB_DRIVER=sqlite 时生效）---
# 数据文件路径，父目录不存在时会自动创建
DB_PATH=data/k_cockpit.db

# --- PostgreSQL 专用（DB_DRIVER=postgres 时生效）---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=k_cockpit
DB_USER=postgres
DB_PASSWORD=change_me
# sslmode: disable | require | verify-ca | verify-full
DB_SSLMODE=disable

# --- 连接池（对 SQLite 无效，SQLite 固定单连接）---
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=1h

# 表结构由 internal/database/migrations/ 下的 SQL 迁移管理，
# 服务启动不做自动建表；执行方式见 docs/02-architecture/DATA_MODEL.md 第 6 节。


# ------------------------------------------------------------
# 缓存 / 队列
# ------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0


# ------------------------------------------------------------
# 鉴权与密钥
# ------------------------------------------------------------
# 生成方式示例: openssl rand -hex 32
APP_SECRET=replace_with_a_random_32_bytes_hex_string

# JWT 签名密钥与有效期
JWT_SECRET=replace_with_a_random_secret
JWT_EXPIRES_IN=7d


# ------------------------------------------------------------
# 第三方服务（按需启用）
# ------------------------------------------------------------
# 对象存储
# STORAGE_ENDPOINT=
# STORAGE_BUCKET=
# STORAGE_ACCESS_KEY=
# STORAGE_SECRET_KEY=

# 邮件服务
# SMTP_HOST=
# SMTP_PORT=465
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=noreply@example.com

# 短信 / 推送
# SMS_ACCESS_KEY_ID=
# SMS_ACCESS_KEY_SECRET=

# AI 模型服务（若项目使用 AI 能力）
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
# AI_MODEL=gpt-4o-mini


# ------------------------------------------------------------
# 可观测性
# ------------------------------------------------------------
# SENTRY_DSN=
# OTEL_EXPORTER_OTLP_ENDPOINT=


# ------------------------------------------------------------
# 前端（若为前后端分离项目，前端变量通常需以 VITE_ / NEXT_PUBLIC_ 等前缀命名）
# ------------------------------------------------------------
# VITE_API_BASE_URL=http://localhost:8080
# NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
