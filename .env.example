# ============================================================
# 环境变量模板
# ------------------------------------------------------------
# 用法：
#   1. cp .env.example .env
#   2. 在 .env 中填入真实值
#   3. .env 已被 .gitignore 忽略，严禁提交
#
# 规则：
#   - 本文件只放「占位值」，绝不放真实密钥
#   - 只登记**代码实际读取**的变量；规划中的能力接入时再登记，避免留下一批
#     「配了却没有任何效果」的死配置
#   - 新增变量必须在此登记，并注明用途与是否必填
# ============================================================

# ------------------------------------------------------------
# 运行环境
# ------------------------------------------------------------
# 可选值: development | test | production
APP_ENV=development

# 调试开关，生产环境必须为 false（开启后会输出完整 SQL）
APP_DEBUG=true

# 服务监听地址与端口
APP_HOST=0.0.0.0
APP_PORT=8080

# 前端构建产物目录（部署时把 web/dist 拷成 public）；目录不存在则只提供 API
STATIC_DIR=public

# 日志级别: debug | info | warn | error
LOG_LEVEL=debug


# ------------------------------------------------------------
# 数据库
# ------------------------------------------------------------
# 驱动类型：postgres 或 sqlite
DB_DRIVER=sqlite

# --- SQLite 专用（DB_DRIVER=sqlite 时生效）---
# 数据文件路径，父目录不存在时会自动创建
DB_PATH=data/k_cockpit.db

# --- PostgreSQL 专用（DB_DRIVER=postgres 时生效）---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=k_cockpit
DB_USER=postgres
DB_PASSWORD=change_me
# sslmode: disable | require | verify-ca | verify-full
DB_SSLMODE=disable

# --- 连接池（对 SQLite 无效，SQLite 固定单连接）---
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=1h

# 服务启动不做自动建表：
#   - PostgreSQL：go run ./cmd/migrate（迁移在 internal/platform/database/migrations/）
#   - 本地 SQLite：go run ./cmd/dev-init（AutoMigrate，可重复执行）
# 详见 docs/02-architecture/DATA_MODEL.md 第 6 节。


# ------------------------------------------------------------
# 节点 agent 通道
# ------------------------------------------------------------
# 只有 gRPC 双向流一种实现（mTLS 反向长连接）。
# 控制面启动后监听该地址，agent 主动拨入；宿主机无需开放入站端口。
AGENT_LISTEN_ADDR=:8443
# 私有 CA 与服务端证书目录；留空落到数据库同级的 agent-pki/
AGENT_TLS_DIR=


# ------------------------------------------------------------
# 鉴权与会话
# ------------------------------------------------------------
# 令牌签名密钥（至少 32 字节）。轮换它会让全部既有令牌立即失效。
# 生成方式: openssl rand -hex 32
# 未配置时：开发环境自动生成临时密钥（重启即失效）；生产环境拒绝启动。
SESSION_SECRET=replace_with_a_random_32_bytes_hex_string

# 会话 Cookie 是否带 Secure 标记。
# HTTPS 部署必须为 true；本地 HTTP 开发必须为 false，否则浏览器不回传 Cookie。
# 默认：APP_ENV=production 时为 true，否则为 false
SESSION_SECURE_COOKIE=false

# 会话空闲超时：从最后一次**真实用户活动**起算
# （轮询与实时通道心跳不续期）
SESSION_IDLE_TIMEOUT=2h

# 会话绝对上限：从签发起算，无论多活跃都会到期
SESSION_ABSOLUTE_TIMEOUT=168h


# ------------------------------------------------------------
# 高风险操作防护（f-10-01）
# ------------------------------------------------------------
# 开发期万能验证码。非空时，TOTP 绑定确认与二次验证都**额外**接受这个固定
# 值（真实方式不受影响，仍然照常可用）。
#
# 存在的唯一理由：开发阶段不必每 30 秒掏一次手机。
#
# 安全约束：
#   - 生产环境配置它会导致服务**启动失败**，不是静默忽略——它不是「弱一点的
#     验证」，而是没有验证：任何知道该值的人都能直接通过高风险操作的门禁；
#   - 每一次命中都会写审计（方式记为 dev_bypass）并打印警告日志；
#   - 服务启动时会打印醒目警告，安全中心页面也会显示「开发模式」标记。
#
# 部署前必须删除本行或置空。留空即关闭该功能。
SECURITY_DEV_BYPASS_CODE=


# ------------------------------------------------------------
# 邮件 / 站点（按需启用，留空即不启用）
# ------------------------------------------------------------
# SMTP_HOST=
# SMTP_PORT=465
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_SECURITY=starttls
# SMTP_FROM=noreply@example.com
# SMTP_FROM_NAME=K Cockpit
# SMTP_TIMEOUT_SECONDS=10

# 站点对外地址（拼进邀请链接等发给站外用户的链接；留空时链接为相对路径）
# SITE_URL=https://panel.example.com

# ------------------------------------------------------------
# 系统设置项的初始值（面板里可改；这里配置后对应项在面板中只读）
# 变量名与 internal/service/platform/settings/spec.go 的 EnvVar 一一对应
# ------------------------------------------------------------
# 输入侧防护（请求过滤）：拦路径穿越 / 空字节 / 扫描器探测与异常 Content-Type
# SECURITY_REQUEST_FILTER_ENABLED=true
# 请求日志开关
# SECURITY_REQUEST_LOG_ENABLED=true
# 会话密钥自动轮换间隔（天，0 = 不自动轮换）
# SECURITY_AUTH_KEY_ROTATE_DAYS=0
# 口令审计是否检查已泄露口令
# SECURITY_PASSWORD_BREACH_CHECK=false
# 日志归档保留数（轮转文件 gzip 压缩存放）
# LOG_KEEP_FILES=5
# 全局带宽总限与突发峰值（Mbps，0 = 不限；下发动作在网络中心）
# NETWORK_GLOBAL_BANDWIDTH_MBPS=0
# NETWORK_GLOBAL_BURST_MBPS=0
# 新建虚拟机的默认磁盘 IOPS（0 = 默认不限）
# VM_DEFAULT_DISK_IOPS=0
# 虚拟机状态判定为陈旧的秒数
# VM_STALE_THRESHOLD_SECONDS=120
# 救援系统 ISO（相对 ISO 存放目录的路径；留空用节点内置默认）
# VM_RESCUE_ISO=
# 存储池状态判定为陈旧的分钟数
# STORAGE_STALE_THRESHOLD_MINUTES=5
# 调度事件保留期（小时）
# SCHEDULER_EVENT_KEEP_HOURS=168
# 存储空间自动回收（每天对全部在线节点 trim）
# STORAGE_AUTO_TRIM_ENABLED=false
# 端口转发宿主机端口自动分配范围（留空分配时生效）
# NETWORK_PORT_RANGE_START=10000
# NETWORK_PORT_RANGE_END=20000
