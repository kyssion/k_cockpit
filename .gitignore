# ============================================================
# k_cockpit - Global .gitignore
# 说明：按「技术栈 / 工具 / 系统」分区整理，覆盖常见语言与 IDE。
# 若项目最终只使用某一种技术栈，可按需删除无关分区。
# ============================================================


# ------------------------------------------------------------
# 1. 操作系统 / 系统文件
# ------------------------------------------------------------

# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Icon?
.fseventsd
.AppleDouble
.LSOverride
*.command

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/
*.lnk
*.stackdump
*.cab
*.msi
*.msix
*.msm
*.msp

# Linux
*~
.directory
.Trash-*
.fuse_hidden*
.nfs*


